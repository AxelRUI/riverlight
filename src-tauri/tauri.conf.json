{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dota Plus Local",
  "version": "0.1.0",
  "identifier": "app.dotapluslocal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Dota Plus Local",
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "maximized": true,
        "resizable": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
